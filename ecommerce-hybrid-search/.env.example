# ---------- 数据库 ----------
PGHOST=localhost
PGPORT=5433
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=ehs

# ---------- L1 Query 理解 ----------
# 不设 ANTHROPIC_API_KEY 也能跑：会自动降级到 jieba + 规则解析器。
# ANTHROPIC_API_KEY=sk-ant-...
#
# 默认 claude-opus-5。生产的延迟敏感路径通常换 claude-haiku-4-5，
# 或者拿 opus 的输出去蒸馏一个自己的小解析模型。
CLAUDE_MODEL=claude-opus-5
# L1 的延迟预算（秒）。超时立刻走规则降级，绝不让 LLM 变成可用性的硬依赖。
L1_TIMEOUT_SECONDS=1.5

# ---------- 模型后端 ----------
# auto  : 能 import sentence-transformers 就用本地模型，否则用 hash（推荐）
# local : 强制本地模型；缺依赖直接报错
# hash  : 确定性伪向量，零下载秒跑。只能演示管线，检索质量是假的
EMBEDDING_BACKEND=auto
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5

# local | claude | none
RERANKER_BACKEND=auto
RERANKER_MODEL=BAAI/bge-reranker-base
